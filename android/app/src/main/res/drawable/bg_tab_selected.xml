<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="3dp"
    android:insetTop="3dp"
    android:insetRight="3dp"
    android:insetBottom="3dp">
    <selector>
        <item android:state_pressed="true">
            <shape>
                <gradient android:angle="90" android:startColor="#F2FFFFFF" android:centerColor="#E0F3F8FF" android:endColor="#C8DCECF7" />
                <corners android:radius="25dp" />
                <stroke android:width="1dp" android:color="#D9FFFFFF" />
            </shape>
        </item>
        <item>
            <shape>
                <gradient android:angle="90" android:startColor="#E6FFFFFF" android:centerColor="#D0EDF5FC" android:endColor="#B5D3E8F4" />
                <corners android:radius="25dp" />
                <stroke android:width="1dp" android:color="#C2D8E8F5" />
            </shape>
        </item>
    </selector>
</inset>
